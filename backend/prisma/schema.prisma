generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id               String            @id @default(uuid())
  googleId         String?           @unique
  email            String            @unique
  name             String
  avatar           String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  senders          Sender[]
  emails           Email[]
  slackConnections SlackConnection[]
}

model Sender {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  email        String
  name         String?
  smtpHost     String
  smtpPort     Int
  smtpUser     String
  smtpPass     String
  hourlyLimit  Int      @default(100)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  emails       Email[]
}

model Email {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  senderId     String?
  sender       Sender?   @relation(fields: [senderId], references: [id], onDelete: SetNull)
  recipient    String
  subject      String
  body         String
  status       String    @default("SCHEDULED") // SCHEDULED | PROCESSING | SENT | FAILED
  scheduledAt  DateTime
  sentAt       DateTime?
  failedAt     DateTime?
  errorMessage String?
  bullJobId    String?   @unique
  attempts     Int       @default(0)
  delayMs      Int       @default(2000)
  hourlyLimit  Int       @default(100)
  isStarred    Boolean   @default(false)
  attachments  String?   // JSON-serialized array of { filename, contentType, size, content }
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model SlackConnection {
  id          String   @id @default(uuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken String
  teamId      String?
  teamName    String?
  channelId   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
